# Copiar como keystore.properties (en esta misma carpeta) y completar con los datos reales.
# keystore.properties y el archivo .jks NO se suben al repositorio.
#
# Para crear un keystore nuevo:
#   keytool -genkeypair -keystore ruta/recordatorios-release.jks -storetype PKCS12 \
#           -alias recordatorios -keyalg RSA -keysize 2048 -validity 10000
storeFile=C:/ruta/fuera/del/repositorio/recordatorios-release.jks
storePassword=CAMBIAR
keyAlias=recordatorios
keyPassword=CAMBIAR
