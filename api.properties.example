# Archivo de EJEMPLO para configurar el servicio remoto.
# Copialo como "api.properties" (en esta misma carpeta) y cambiá los valores si hace falta.
# api.properties está en .gitignore: nunca se sube al repositorio.
# Si api.properties no existe, Gradle usa los valores de este archivo.

# URL base del servicio. Tiene que terminar con "/".
# Con el emulador se usa localhost y, antes de abrir la app, se ejecuta en la PC:
#     adb reverse tcp:3000 tcp:3000
# Eso conecta el puerto 3000 del emulador con el puerto 3000 de la PC (donde corre servidor.py).
# Alternativa sin adb reverse: http://10.0.2.2:3000/ (10.0.2.2 es la PC vista desde el emulador;
# en algunas configuraciones del emulador esa dirección no responde a las apps).
api.baseUrl=http://localhost:3000/

# Clave que pide el servidor simulado en el encabezado X-Api-Key.
# Es un valor de prueba para desarrollo local, no una credencial real.
api.key=clave-de-prueba-local
