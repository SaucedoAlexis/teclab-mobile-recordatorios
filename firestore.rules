rules_version = '2';

// Reglas de seguridad de Cloud Firestore para la app Recordatorios (Actividad 4).
// Copia en el repositorio: firestore.rules
// La autorizacion la decide el servidor: cada cuenta solo lee y escribe debajo de su propio uid.
service cloud.firestore {
  match /databases/{database}/documents {

    // Recordatorios de cada cuenta: users/{uid}/reminders/{reminderId}
    match /users/{uid}/reminders/{reminderId} {
      allow read, delete: if esDueno(uid);
      allow create, update: if esDueno(uid) && datosValidos(uid);
    }

    // Todo lo demas queda cerrado

    function esDueno(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function datosValidos(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'titulo', 'descripcion', 'categoria', 'prioridad', 'completado',
                               'fechaCompletado', 'fechaCreacion', 'actualizadoEn', 'sincronizadoEn'])
        && d.uid == uid
        && d.titulo is string && d.titulo.size() > 0 && d.titulo.size() <= 200
        && (d.descripcion == null || (d.descripcion is string && d.descripcion.size() <= 200))
        && d.categoria is string && d.categoria.size() > 0
        && d.prioridad in ['ALTA', 'MEDIA', 'BAJA']
        && d.completado is bool
        && (d.fechaCompletado == null || d.fechaCompletado is int)
        && d.fechaCreacion is int
        && d.actualizadoEn is int;
    }
  }
}
